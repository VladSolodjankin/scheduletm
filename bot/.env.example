NODE_ENV=development
PORT=3002
APP_URL=http://localhost:5173
WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
APP_ENCRYPTION_KEY=replace_with_the_same_strong_key_used_by_the_server

DATABASE_PUBLIC_URL=postgres://user:pass@localhost:5432/scheduletm
DATABASE_URL=postgres://user:pass@localhost:5432/scheduletm

EMAIL_VERIFY_BASE_URL=http://localhost:5173
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Meetli

AUTO_SET_WEBHOOK=false
WEBHOOK_RATE_LIMIT=60
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
