TRUSTED_PROXY_HOPS=0
NOTIFICATION_POLL_MS=60000
ALERT_POLL_MS=60000
ALERT_NO_UPDATES_THRESHOLD_MS=900000
ALERT_FAILED_GROWTH_THRESHOLD=5
TELEGRAM_USER_SESSION_RETENTION_MS=2592000000
TELEGRAM_USER_SESSION_CLEANUP_INTERVAL_MS=86400000
