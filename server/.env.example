PORT=3003
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3003
DATABASE_PUBLIC_URL=postgres://user:pass@localhost:5432/scheduletm
DATABASE_URL=postgres://user:pass@localhost:5432/scheduletm
SESSION_COOKIE_NAME=scheduletm_refresh
# Use `.meetli.cc` in production; keep empty for local development.
SESSION_COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://meetli.cc,https://www.meetli.cc
ACCESS_TOKEN_TTL_SECONDS=9000
REFRESH_TOKEN_TTL_DAYS=30

# Email (Brevo SMTP API)
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM_ADDRESS=no-reply@meetli.cc
EMAIL_FROM_NAME=Meetli
EMAIL_VERIFY_BASE_URL=http://localhost:5173

# Google OAuth 2.0 (Calendar integration)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3003/api/integrations/google/oauth/callback
# Optional (space-separated scopes). Leave empty to use defaults.
GOOGLE_OAUTH_SCOPES=
# Write scope requested TOGETHER with the read scopes in the single "Connect Google" consent (granular consent
# lets the user untick it). If the user unticks it, the connection fails (reason=calendar_write_required) and
# appointments are synced to Google automatically whenever the write scope was granted.
# calendar.events / calendar are merely recognised as granted write scopes, never requested.
# If the Google Console lacks calendar.events.owned, set this to https://www.googleapis.com/auth/calendar.events
GOOGLE_OAUTH_WRITE_SCOPE=https://www.googleapis.com/auth/calendar.events.owned

# Required for encryption of sensitive values stored in DB (for example system-level Telegram alert credentials).
APP_ENCRYPTION_KEY=replace_with_long_random_secret
TELEGRAM_BOT_TOKEN=


# Zoom OAuth 2.0 (Meeting Links integration)
ZOOM_OAUTH_CLIENT_ID=your_zoom_oauth_client_id
ZOOM_OAUTH_CLIENT_SECRET=your_zoom_oauth_client_secret
ZOOM_OAUTH_REDIRECT_URI=http://localhost:3003/api/integrations/zoom/oauth/callback

# Optional (space-separated scopes). Leave empty to use defaults (meeting:write:meeting
# user:read:user) — these MUST match the scopes registered/approved for this app in the
# Zoom Marketplace console (Scopes section); Zoom rejects a request for any unregistered scope.
ZOOM_OAUTH_SCOPES=

# Yandex Telemost OAuth (Meeting Links integration). Register the app at https://oauth.yandex.ru
# with the Telemost API permission (telemost-api:conferences.create) and the redirect URI below.
YANDEX_OAUTH_CLIENT_ID=your_yandex_oauth_client_id
YANDEX_OAUTH_CLIENT_SECRET=your_yandex_oauth_client_secret
YANDEX_OAUTH_REDIRECT_URI=http://localhost:3003/api/integrations/yandex/oauth/callback
# Optional (space-separated scopes). Leave empty to use the default telemost-api:conferences.create.
YANDEX_OAUTH_SCOPES=

# Zoom webhook (Event Subscriptions -> Secret Token in the Zoom App). Required to receive
# meeting.started/ended/deleted webhooks; leave empty to leave the webhook endpoint disabled.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Stripe Connect (optional, Payment setup). Standard connected accounts via OAuth, direct charges, no platform fee.
# Leave empty to leave Stripe unconfigured (the connect endpoint responds 503). STRIPE_WEBHOOK_SECRET is the
# signing secret (whsec_...) of a *Connect* webhook endpoint -> POST <API_BASE_URL>/api/integrations/stripe/webhook
# subscribed to checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired.
# YooKassa and Bank of Georgia need no platform env: each account enters its own credentials in Settings > Payment setup.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_OAUTH_REDIRECT_URI=http://localhost:3003/api/integrations/stripe/oauth/callback

# Optional. When set, request rate limiting uses this shared Redis instance instead of
# an in-process Map, so limits are enforced correctly across multiple server instances.
# Leave empty for a single-instance deployment.
REDIS_URL=
