{
  "name": "meetli",
  "private": true,
  "version": "0.1.0",
  "description": "Meetli monorepo (bot, server, web)",
  "workspaces": [
    "shared",
    "bot",
    "server",
    "web"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "lint": "npm run -ws lint --if-present",
    "typecheck": "npm run -ws typecheck --if-present",
    "test": "npm run -ws test --if-present",
    "build": "npm run -ws build --if-present",
    "qa:web": "npm run -w @meetli/web verify",
    "qa:server": "npm run -w @meetli/server verify",
    "qa:bot": "npm run -w @meetli/bot verify",
    "prepare": "npm run -w @meetli/shared build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "body-parser": "^2.3.0",
    "fast-uri": "^3.1.8"
  }
}
